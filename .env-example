# AR.I.S — Environment Configuration Example
# Copy this file to .env and configure values appropriately for your environment.

# Django Security and Core Settings
SECRET_KEY=django-insecure-aris-core-cognitive-engine-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Connection Settings (Primary AR.I.S Database)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root@123
MYSQL_DATABASE=aris_db

# Neural Model & Tokenizer Paths (Resolves relative to project root)
LM_CHECKPOINT_PATH=aris_lm_checkpoint.pt
TOKENIZER_PATH=models/aris_bpe_tokenizer.json

# Hugging Face API Authentication (High-Volume Dataset Downloads)
HF_TOKEN=your_huggingface_token_here
