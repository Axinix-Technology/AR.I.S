# AR.I.S — Environment Configuration Example
# Copy this file to .env and configure values appropriately for your environment.

# Django Security and Core Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Connection Settings
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=aris_db
